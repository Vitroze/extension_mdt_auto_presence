{
  "manifest_version": 3,
  "name": "RHS - AutoPresence MDT",
  "version": "1.0.1",
  "description": "Remplis automatiquement la section 'Présence' lorsqu'il a des RHS du MDT.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mdt-auto-presence-extension@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "host_permissions": ["https://mdt.gtacityrp.fr/*"],
  "action": {},
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["https://mdt.gtacityrp.fr/*"],
      "js": ["script.js"],
      "run_at": "document_idle"
    }
  ]
}
